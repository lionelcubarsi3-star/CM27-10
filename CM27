name: Build CM27 Android APK

on:
  workflow_dispatch:
  push:
    branches: [main, master]

permissions:
  contents: read

jobs:
  build-apk:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - uses: actions/setup-node@v4
        with:
          node-version: '22'

      - name: Extract project ZIP
        run: unzip -q CM27_ANDROID_PROJECT.zip -d cm27src

      - name: Build Android APK
        run: |
          cd cm27src
          npm install
          npm run copy-web
          npx cap add android
          npx cap sync android
          cd android
          chmod +x gradlew
          ./gradlew assembleDebug

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: CM27-debug-APK
          path: cm27src/android/app/build/outputs/apk/debug/app-debug.apk
          if-no-files-found: error
